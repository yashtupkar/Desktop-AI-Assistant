# ============================================================
#  Nova / Jarvis Desktop AI Assistant — Environment Variables
#  Copy this file to .env and fill in your values.
# ============================================================

# --- OpenRouter ---
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_URL=https://openrouter.ai/api/v1

# --- Default AI Models ---
# Non-streaming chat (ai-chat IPC)
DEFAULT_MODEL=google/gemini-2.5-flash-lite
# Streaming chat (ai-chat-stream IPC)
STREAM_MODEL=google/gemma-2-9b-it:free

# --- App Identity (sent as headers to OpenRouter) ---
APP_REFERER=https://github.com/yashtupkar/Desktop-AI-Assistant
APP_TITLE=Nova AI Assistant

# --- Chrome Automation ---
# Override if Chrome is installed in a non-standard location
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_DEBUG_PORT=9222

# --- TTS Voice ---
TTS_VOICE=en-US-AriaNeural
TTS_LANG=en-US

# --- Vite Dev Server ---
VITE_DEV_PORT=5173
